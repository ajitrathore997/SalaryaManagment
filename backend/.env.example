# Server
NODE_ENV=development
PORT=4000

# Database — replace with your actual PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/salary_management

# JWT — replace with a long, random secret (min 32 chars)
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# CORS — origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
